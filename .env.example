# SparkHQ Minimal Production Environment Variables (Blueprint)

# 1. Founder Security Passcode
FOUNDER_PASSCODE="your_secret_founder_passcode"

# 2. AI Core (Google AI Studio)
GEMINI_API_KEY="your_gemini_api_key"

# 3. GitHub Automation (CTO Agent PR Generator)
GITHUB_TOKEN="ghp_your_github_token"
GITHUB_OWNER="Philioraptor"
GITHUB_REPO="SparkHQ"

# 4. Razorpay Production Live Gateway
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_your_key_id"

# 5. Database & Cache
DATABASE_URL="postgresql://user:password@host:5432/sparkhq_db"
REDIS_URL="rediss://default:password@host:6379"

# 6. Server Config
PORT=4000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

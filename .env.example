# SparkHQ Production Environment Credentials (Blueprint)

# Founder Security Passcode (Locks Command Center Dashboard)
FOUNDER_PASSCODE="your_secret_founder_passcode_here"

# Razorpay Standard Web Checkout Integration
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Database & Cache
DATABASE_URL="postgresql://user:password@render-host:5432/sparkhq_db?sslmode=require"
REDIS_URL="rediss://default:password@render-redis-host:6379"

# AI Core (Gemini 2.5 Flash / Google Gen AI)
GEMINI_API_KEY="your-gemini-api-key"

# GitHub Integration
GITHUB_TOKEN="ghp_your_github_personal_access_token"
GITHUB_OWNER="Philioraptor"
GITHUB_REPO="SparkHQ"

# LinkedIn OAuth App Integration
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"

# Server Ports & Service Configs
PORT=4000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

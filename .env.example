# SparkHQ AI C-Suite System - Environment Variables Blueprint

# Database & Cache
DATABASE_URL="postgresql://user:password@render-host:5432/sparkhq_db?sslmode=require"
REDIS_URL="rediss://default:password@render-redis-host:6379"

# AI Core (Gemini 2.5 Flash / Google Gen AI)
GEMINI_API_KEY="your-gemini-api-key"

# Integrations
GITHUB_TOKEN="ghp_your_github_personal_access_token"
GITHUB_OWNER="sparkhq-ai"
GITHUB_REPO="sparkhq-monorepo"

LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"

# Server Ports & Service Configs
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"

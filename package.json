{
  "name": "sparkhq-c-suite",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev:command-center": "npm run dev --prefix apps/command-center",
    "build:command-center": "npm run build --prefix apps/command-center",
    "build:shared": "npm run build --prefix packages/shared-types",
    "build": "npm run build:shared && npm run build:command-center",
    "prisma:generate": "cd packages/database && npx prisma generate",
    "prisma:push": "cd packages/database && npx prisma db push"
  },
  "dependencies": {
    "razorpay": "^2.9.8"
  }
}
